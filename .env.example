# Google Gemini API key — required for the AI assistant.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-flash-lite-latest)
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: the site's public URL, used for SEO metadata (Open Graph, sitemap,
# robots.txt). Safe to expose to the client. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
